      "rule_code": "EMI_OVERDUE_30_PLUS",
      "name": "EMI overdue more than 30 days",
      "description": "Instalment unpaid beyond 30 days. The account is materially delinquent.",
      "category": "REPAYMENT",
      "severity": "RED",
      "condition_logic": "ALL",
      "suppression_hours": 24,
      "auto_resolve": true,
      "assign_to_role": "RISK_MANAGER",
      "sla_hours_acknowledge": 4,
      "sla_hours_resolve": 72,
      "priority": 10,
      "recommended_action": "Issue a formal demand notice. Assess restructure versus recovery. Verify vehicle location within 48 hours.",
