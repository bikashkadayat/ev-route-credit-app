# EV-RCA local development configuration — Doc 02 §2.17
# Copy to .env and adjust. NEVER commit .env (see .gitignore).

APP_ENV=local

# --- database -----------------------------------------------------------------
POSTGRES_USER=evrca
POSTGRES_PASSWORD=evrca
POSTGRES_DB=evrca
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://evrca:evrca@localhost:5432/evrca
# The async driver the API uses at runtime; Alembic rewrites this to +psycopg itself.
DATABASE_URL_ASYNC=postgresql+asyncpg://evrca:evrca@localhost:5432/evrca

# --- auth ---------------------------------------------------------------------
JWT_SECRET_KEY=change-me-in-every-environment
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Lockout and session policy - Doc 09 9.2.2, 9.2.4
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
FAILED_ATTEMPT_WINDOW_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# --- integrations (mock | live) ------------------------------------------------
CIB_PROVIDER=mock
TELEMATICS_PROVIDER=mock
CIB_REPORT_VALIDITY_DAYS=90

# --- demo ---------------------------------------------------------------------
# Seeds the deterministic mock data. Changing it changes every generated series.
DEMO_SEED=20260908

# --- optional -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- observability -------------------------------------------------------------
# GET /metrics is unauthenticated by necessity (a scraper has no user identity), so it
# must be restricted to the internal network at the ingress. Set false to switch it off.
METRICS_ENABLED=true
